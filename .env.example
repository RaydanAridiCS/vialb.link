# =============================================================================
# ToolWright configuration. Copy to `.env` and adjust. Every variable is
# validated at startup (src/lib/env.ts): the app refuses to boot when a value
# is missing or malformed. Full reference: docs/configuration.md
# =============================================================================

# --- Core (required) ---------------------------------------------------------
# Public base URL. Drives every absolute URL: short links, OG tags, QR codes.
SITE_URL=http://localhost:3000
# PostgreSQL connection string. (docker-compose.yml overrides this for the app container.)
DATABASE_URL=postgres://toolwright:toolwright@localhost:5432/toolwright
# Random secret, at least 32 chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Auth base URL (defaults to SITE_URL). Only set when auth is served elsewhere.
# BETTER_AUTH_URL=

# --- Docker Compose only -----------------------------------------------------
POSTGRES_USER=toolwright
POSTGRES_PASSWORD=toolwright
POSTGRES_DB=toolwright
# Host port the app container is published on.
APP_PORT=3000

# --- Accounts ---------------------------------------------------------------
# The first user to sign up becomes admin. Optionally promote a specific email:
# ADMIN_EMAIL=you@example.com
ALLOW_SIGNUPS=true
REQUIRE_EMAIL_VERIFICATION=false
# OAuth providers are enabled only when both values are set.
# Callback URLs: ${SITE_URL}/api/auth/callback/github and .../google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Email (optional; enables password reset & verification) ------------------
# Without SMTP, emails are written to the server log (development only).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="ToolWright <no-reply@example.com>"

# --- Anonymous links ----------------------------------------------------------
ALLOW_ANONYMOUS_LINKS=false
# Forced lifetime of anonymous links, in hours (default 30 days).
ANON_LINK_TTL_HOURS=720

# --- Redirect behaviour ---------------------------------------------------------
# 302 (default) or 307. Permanent 301/308 are never used for short links.
REDIRECT_STATUS=302
# Append the short link's query string (?utm_source=…) to the destination.
FORWARD_QUERY_PARAMS=true
# Referrer-Policy sent with redirects: strict-origin-when-cross-origin | unsafe-url | origin | no-referrer
REFERRER_POLICY=strict-origin-when-cross-origin
# Expose /{code}/qr publicly (owners can always download QR codes).
PUBLIC_QR_ENDPOINT=false

# --- Reverse proxy / client IP ---------------------------------------------------
# Set TRUST_PROXY=true ONLY behind a reverse proxy that sets X-Forwarded-For.
# TRUSTED_PROXY_HOPS = number of proxies in front of the app (Cloudflare + Caddy = 2).
TRUST_PROXY=false
TRUSTED_PROXY_HOPS=1
# HSTS max-age in seconds (sent only when SITE_URL is https). 0 disables it.
HSTS_MAX_AGE=15552000

# --- Geolocation (no third-party lookups, ever) --------------------------------
# Trust CDN geo headers (cf-ipcountry, x-vercel-ip-country, …). Only behind such a CDN!
TRUST_PROXY_GEO_HEADERS=false
# Path to a MaxMind GeoLite2-City.mmdb (or Country) file. See docs/self-hosting.md.
# GEOLITE2_DB_PATH=/data/GeoLite2-City.mmdb

# --- Scaling ------------------------------------------------------------------
# Shared rate limiting across replicas. Without it, an in-memory limiter is used.
# REDIS_URL=redis://redis:6379

# --- Anti-abuse (optional) ---------------------------------------------------------
# Cloudflare Turnstile for anonymous link creation.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Google Safe Browsing lookup when links are created (not per click).
# SAFE_BROWSING_API_KEY=

# --- Operations -------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Opt out of Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1
