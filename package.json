{
  "name": "toolwright",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "build:migrate": "esbuild scripts/migrate.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/migrate.cjs",
    "seed": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/seed.ts",
    "import:legacy": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/import-legacy.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@better-auth/api-key": "^1.7.10",
    "@hookform/resolvers": "^5.9.2",
    "@maxmind/geoip2-node": "^7.1.0",
    "@node-rs/argon2": "^2.2.2",
    "@scalar/nextjs-api-reference": "^0.12.11",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-table": "^9.3.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "input-otp": "^1.5.0",
    "ioredis": "^6.0.0",
    "isbot": "^5.2.2",
    "lucide-react": "^1.59.0",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "next-safe-action": "^8.7.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.2",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.1.1",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "description": "Open-source, self-hostable URL shortener with privacy-friendly analytics.",
  "license": "MIT",
  "author": "Raydan Aridi",
  "repository": {
    "type": "git",
    "url": "https://github.com/RaydanAridiCS/toolwright.git"
  },
  "homepage": "https://github.com/RaydanAridiCS/toolwright#readme",
  "bugs": {
    "url": "https://github.com/RaydanAridiCS/toolwright/issues"
  },
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
